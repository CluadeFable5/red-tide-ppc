# ---------------------------------------------------------------------------
# Red Tide PPC — environment variables
#
# Copy this file to `.env` and fill in the values from your Firebase project:
#   Firebase console → Project settings → General → "Your apps" → Web app
#
# `.env` is gitignored. `.env.example` is safe to commit.
#
# Vite only exposes variables prefixed with VITE_ to the browser bundle. That
# means every value below is PUBLIC — it ships in the JS. These are not
# secrets; access control lives in Firestore rules and Cloudinary preset settings.
# ---------------------------------------------------------------------------

VITE_FIREBASE_API_KEY=AIza...
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000

# Cloudinary dashboard → Settings → API Keys (Cloud Name) and Settings → Upload → Upload presets.
VITE_CLOUDINARY_CLOUD_NAME=your-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=your-unsigned-upload-preset

# Passcode for the /admin approval view.
#
# SECURITY NOTE (MVP, insecure by design): this is a client-side string compare.
# Anyone can read it in the page source. It stops honest mistakes and demos, not
# attackers. Replace with Firebase Auth + an admin role before real use.
VITE_ADMIN_PASSCODE=change-me

# ---------------------------------------------------------------------------
# Optional
# ---------------------------------------------------------------------------
# Leave VITE_USE_DEMO_BACKEND empty/unset for normal Firebase behaviour.
# Set it to "true" to force the built-in offline demo backend (in-memory +
# localStorage) even when Firebase keys are present — handy for demos and for
# working without a network.
#
# If no Firebase keys are set at all, the app automatically falls back to demo
# mode so `npm run dev` always produces a working app.
VITE_USE_DEMO_BACKEND=
